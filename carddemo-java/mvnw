# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup script (POSIX shell), version 3.3.4
#
# Optional ENV vars
# -----------------
#   JAVA_HOME - location of a JDK home dir, required when download maven via java source
#   MVNW_REPOURL - repo url base for downloading maven distribution
#   MVNW_USERNAME/MVNW_PASSWORD - user and password for downloading maven
#   MVNW_VERBOSE - true: enable verbose log; debug: trace the mvnw script; others: silence the output
#   MAVEN_USER_HOME - Maven user home; the downloaded distribution is cached
#                     under $MAVEN_USER_HOME/wrapper/dists (default ~/.m2)
#   MAVEN_OPTS - JVM options for the Maven process; forwarded untouched
#   MAVEN_ARGS - default command line arguments; forwarded untouched
#
# Only the MVNW_* variables are consumed by this launcher, and exec_maven()
# unsets exactly those four before handing control over, so JAVA_HOME,
# MAVEN_OPTS and MAVEN_ARGS reach the real mvn launcher unmodified and behave
# there exactly as they do for a locally installed Maven. That pass-through is
# what lets the CI workflow export MAVEN_ARGS="-B -ntp" once and have every
# ./mvnw invocation honour it.
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# CardDemo :: carddemo-java :: POSIX Maven Wrapper launcher
# ----------------------------------------------------------------------------
# Purpose. A clean checkout builds with no preinstalled Maven: a JDK is the only
# prerequisite. This script resolves, downloads, verifies, caches and then executes
# the exact Apache Maven distribution the module is pinned to and forwards every
# argument to it, so `./mvnw clean verify` behaves identically on a developer
# machine, in the Docker builder stage and on a hosted CI runner.
#
# Provenance. The executable body derives from the canonical Apache Maven Wrapper
# POSIX launcher, version 3.3.4, published on Maven Central as
#   org.apache.maven.wrapper:maven-wrapper-distribution:3.3.4:zip:only-script
# whose mvnw member has SHA-256
#   cae96cef89ebea3531221f4ae17c23cf8edf67d00eae8306d4186ae1bbed4d02
# so this file can be diffed against upstream at any time. The canonical script is
# used rather than a bespoke downloader because a developer's existing expectations
# of ./mvnw are part of the contract.
#
# Deviations from upstream, stated exhaustively so the diff is never a surprise.
# Presentation-only: the licence header, these comment blocks, the three extra
# MVNW_* variables documented above and the wrapperVersion line in the properties
# parser. Behavioural, each annotated inline where it appears:
#   1. The URL is never rewritten to the -bin.tar.gz variant when unzip is missing;
#      upstream fetches that archive while still validating it against the .zip
#      digest pinned in the properties file, which cannot succeed.
#   2. SHA-256 validation falls back to java.security when neither sha256sum nor
#      shasum is on PATH instead of exiting 1. Verification stays mandatory: a
#      mismatch still fails closed, and only an absent JDK now stops the build.
#   3. Extraction falls back to the JDK's zip filesystem provider when unzip is
#      missing, replacing an untar branch that is no longer reachable.
#   4. distributionSha256Sum is MANDATORY, not optional. Upstream verifies only
#      when the key happens to be set and otherwise downloads and executes an
#      unverified archive after a one-line note; here an absent or malformed digest
#      is a hard failure, checked before anything is fetched. "Verified, not
#      trusted" is not a property a launcher can hold if the verification is
#      switchable from the file it reads.
#   5. The transport is policed. Both the configured URL and the MVNW_REPOURL
#      rewrite of it must be https and must not embed credentials; curl and wget
#      are told to refuse a redirect that leaves https; the JDK downloader follows
#      redirects itself, one hop at a time, refusing any that is not https and
#      offering credentials only to the host the properties file names. Every
#      diagnostic that prints a URL prints it redacted.
#   6. The cache is validated rather than assumed, and installed under a lock.
#      Upstream trusts any directory at MAVEN_HOME, installs it with a move that
#      crosses filesystems when the staging directory is on another mount, and
#      treats a failed move as success whenever the destination merely exists - so
#      one interrupted or concurrent cold start can publish a partial distribution
#      that every later invocation reuses. Here a cache counts as installed only
#      when bin/<mvn>, lib/ and a mvnw.url marker naming this exact distribution
#      are all present; installation is serialised per distribution through an
#      atomically created lock directory; staging happens inside the cache parent
#      so publication is a same-filesystem rename; an incomplete cache is set
#      aside and rebuilt; and the published result is re-validated before Maven is
#      executed from it.
# Resolution, HTTP authentication, argument forwarding and the exec handover are
# otherwise untouched, and the cache directory computed for a given
# distributionUrl is unchanged, so an existing ~/.m2/wrapper/dists entry is reused.
#
# The only-script distribution type declared in .mvn/wrapper/maven-wrapper.properties
# makes this launcher perform the download itself, so no maven-wrapper.jar is
# committed and no unscanned binary enters the supply chain. The same file supplies
# distributionSha256Sum, and the download is rejected unless it matches, so a
# tampered or truncated archive fails closed rather than silently producing a build
# with an unknown toolchain. That file is also the only place the Maven version and
# the distribution URL appear - not this script, not mvnw.cmd, not the Dockerfile,
# not the CI workflow - so upgrading Maven is a one-line change that cannot leave a
# stale second copy behind. Run with MVNW_VERBOSE=true to echo the wrapper version,
# the resolved URL and the cache directory in use.
# ----------------------------------------------------------------------------

set -euf
[ "${MVNW_VERBOSE-}" != debug ] || set -x

# OS specific support.
native_path() { printf %s\\n "$1"; }
case "$(uname)" in
CYGWIN* | MINGW*)
  [ -z "${JAVA_HOME-}" ] || JAVA_HOME="$(cygpath --unix "$JAVA_HOME")"
  native_path() { cygpath --path --windows "$1"; }
  ;;
esac

# set JAVACMD and JAVACCMD
set_java_home() {
  # For Cygwin and MinGW, ensure paths are in Unix format before anything is touched
  if [ -n "${JAVA_HOME-}" ]; then
    if [ -x "$JAVA_HOME/jre/sh/java" ]; then
      # IBM's JDK on AIX uses strange locations for the executables
      JAVACMD="$JAVA_HOME/jre/sh/java"
      JAVACCMD="$JAVA_HOME/jre/sh/javac"
    else
      JAVACMD="$JAVA_HOME/bin/java"
      JAVACCMD="$JAVA_HOME/bin/javac"

      if [ ! -x "$JAVACMD" ] || [ ! -x "$JAVACCMD" ]; then
        echo "The JAVA_HOME environment variable is not defined correctly, so mvnw cannot run." >&2
        echo "JAVA_HOME is set to \"$JAVA_HOME\", but \"\$JAVA_HOME/bin/java\" or \"\$JAVA_HOME/bin/javac\" does not exist." >&2
        return 1
      fi
    fi
  else
    JAVACMD="$(
      'set' +e
      'unset' -f command 2>/dev/null
      'command' -v java
    )" || :
    JAVACCMD="$(
      'set' +e
      'unset' -f command 2>/dev/null
      'command' -v javac
    )" || :

    if [ ! -x "${JAVACMD-}" ] || [ ! -x "${JAVACCMD-}" ]; then
      echo "The java/javac command does not exist in PATH nor is JAVA_HOME set, so mvnw cannot run." >&2
      return 1
    fi
  fi
}

# hash string like Java String::hashCode
hash_string() {
  str="${1:-}" h=0
  while [ -n "$str" ]; do
    char="${str%"${str#?}"}"
    h=$(((h * 31 + $(LC_CTYPE=C printf %d "'$char")) % 4294967296))
    str="${str#?}"
  done
  printf %x\\n $h
}

verbose() { :; }
[ "${MVNW_VERBOSE-}" != true ] || verbose() { printf %s\\n "${1-}"; }

die() {
  printf %s\\n "$1" >&2
  exit 1
}

trim() {
  # MWRAPPER-139:
  #   Trims trailing and leading whitespace, carriage returns, tabs, and linefeeds.
  #   Needed for removing poorly interpreted newline sequences when running in more
  #   exotic environments such as mingw bash on Windows.
  printf "%s" "${1}" | tr -d '[:space:]'
}

# CardDemo addition :: transport policy (deviation 5). Three primitives, kept
# separate so each is obvious on its own. url_authority returns the authority
# component - everything between the scheme separator and the first following
# slash - which is the only part of a URL that may carry userinfo; matching the
# whole URL for '@' would false-positive on a path segment that contains one.
url_authority() {
  _mvnw_url_rest="${1#*://}"
  printf %s\\n "${_mvnw_url_rest%%/*}"
}

url_has_userinfo() {
  case "$(url_authority "${1-}")" in
  *@*) return 0 ;;
  *) return 1 ;;
  esac
}

# Replaces any userinfo with fixed text, so a URL can be printed in a diagnostic
# or a verbose line without printing a credential that was embedded in it. The
# URL is rejected outright further down, but the rejection message itself has to
# quote the URL to be useful, and that message must not be the leak.
redact_url() {
  if url_has_userinfo "${1-}"; then
    _mvnw_url_scheme="${1%%://*}"
    _mvnw_url_rest="${1#*://}"
    _mvnw_url_authority="${_mvnw_url_rest%%/*}"
    printf %s\\n "$_mvnw_url_scheme://***:***@${_mvnw_url_authority#*@}${_mvnw_url_rest#"$_mvnw_url_authority"}"
  else
    printf %s\\n "${1-}"
  fi
}

# The transport contract, asserted rather than assumed. $2 names where the URL came
# from, so a failure says which of the two inputs - the properties file or the
# MVNW_REPOURL override - has to be corrected.
assert_secure_url() {
  case "${1-}" in
  https://?*) ;;
  *)
    die "$2 must be an https URL, so the distribution cannot be fetched over a channel that permits substitution or credential capture; found '$(redact_url "${1-}")'"
    ;;
  esac
  if url_has_userinfo "${1-}"; then
    die "$2 must not embed credentials in the URL; set MVNW_USERNAME and MVNW_PASSWORD instead, which are sent only to the host named by the URL. Found '$(redact_url "${1-}")'"
  fi
}

scriptDir="$(dirname "$0")"
scriptName="$(basename "$0")"

# parse distributionUrl and optional distributionSha256Sum, requires .mvn/wrapper/maven-wrapper.properties
# wrapperVersion is read alongside them: it records the Apache Maven Wrapper
# release these launcher scripts were generated from, and reporting it under
# MVNW_VERBOSE=true is how a build log evidences which launcher generation
# produced it. It is informational only - the version of Maven itself comes
# solely from distributionUrl - so an absent key degrades to "unknown" rather
# than failing the build.
while IFS="=" read -r key value; do
  case "${key-}" in
  distributionUrl) distributionUrl=$(trim "${value-}") ;;
  distributionSha256Sum) distributionSha256Sum=$(trim "${value-}") ;;
  wrapperVersion) wrapperVersion=$(trim "${value-}") ;;
  esac
done <"$scriptDir/.mvn/wrapper/maven-wrapper.properties"
[ -n "${distributionUrl-}" ] || die "cannot read distributionUrl property in $scriptDir/.mvn/wrapper/maven-wrapper.properties"
verbose "Apache Maven Wrapper ${wrapperVersion:-unknown}, configured by $scriptDir/.mvn/wrapper/maven-wrapper.properties"
verbose "configured distributionUrl: $(redact_url "$distributionUrl")"

# CardDemo modification :: deviations 4 and 5. Everything the properties file says
# about the distribution is checked HERE, before the cache is consulted and long
# before anything is fetched. Ordering is the point: a launcher that validates
# after a cache hit leaves a machine that already holds a distribution running
# whatever it holds, and a launcher that validates after a download has already
# spent the network on an archive it was never going to be allowed to use.
assert_secure_url "$distributionUrl" "distributionUrl in $scriptDir/.mvn/wrapper/maven-wrapper.properties"

# The digest is mandatory. Upstream treats it as optional and silently downgrades
# to an unverified install when the key is absent or blank, which makes "verified,
# not trusted" a property of the configuration rather than of the launcher. Both
# the presence and the shape are checked, because a truncated or upper-case value
# would otherwise fail later as a mismatch and read as a compromised archive
# rather than as a mis-edited properties file.
case "${distributionSha256Sum-}" in
'')
  die "distributionSha256Sum is not set in $scriptDir/.mvn/wrapper/maven-wrapper.properties. This launcher refuses to install a Maven distribution it cannot verify; add the SHA-256 of the pinned archive rather than removing the check."
  ;;
esac
if [ ${#distributionSha256Sum} -ne 64 ] || [ -n "$(printf %s "$distributionSha256Sum" | tr -d '0-9a-f')" ]; then
  die "distributionSha256Sum in $scriptDir/.mvn/wrapper/maven-wrapper.properties must be exactly 64 lowercase hexadecimal characters, and it is not. A malformed digest cannot verify anything, so the build stops here rather than at a mismatch that would look like a tampered archive."
fi
verbose "distributionSha256Sum: present and well formed; verification of the downloaded archive is mandatory"

# The archive shape, likewise checked up front, and against exactly the pattern
# the properties file documents as a guarantee: an apache-maven -bin.zip and
# nothing else. Upstream reaches its own shape test only after the cache lookup,
# so a distributionUrl naming an archive the launcher cannot handle is diagnosed
# on a cold machine and silently tolerated on a warm one - the same configuration
# behaving differently depending on cache state. Upstream also accepts a
# maven-mvnd archive, which this launcher cannot: mvnd publishes no digest it
# could be held to, the digest is not optional here, and upstream's remedy for
# that collision is to remove distributionSha256Sum - the one remedy this module
# does not accept. mvnd is therefore refused at the point of configuration rather
# than part way through an install, and it is refused with its own message so the
# reason is not mistaken for a typo in the URL.
case "${distributionUrl##*/}" in
maven-mvnd-*)
  die "maven-mvnd is not supported by this launcher: distributionSha256Sum is mandatory here and an mvnd distribution cannot be verified against it. Pin an apache-maven -bin.zip in $scriptDir/.mvn/wrapper/maven-wrapper.properties."
  ;;
esac
case "${distributionUrl-}" in
*?-bin.zip) ;;
*) die "distributionUrl is not valid, must name an apache-maven *-bin.zip archive, but found '$(redact_url "${distributionUrl-}")'" ;;
esac
MVN_CMD="mvn${scriptName#mvnw}" _MVNW_REPO_PATTERN=/org/apache/maven/

# apply MVNW_REPOURL and calculate MAVEN_HOME
# maven home pattern: ~/.m2/wrapper/dists/apache-maven-<version>/<hash>
if [ -n "${MVNW_REPOURL-}" ]; then
  distributionUrl="$MVNW_REPOURL$_MVNW_REPO_PATTERN${distributionUrl#*"$_MVNW_REPO_PATTERN"}"
  # CardDemo modification :: deviation 5. The override is held to the same
  # transport contract as the configured URL. Upstream applies it unchecked, so a
  # mirror base of http:// or one carrying userinfo silently downgrades a
  # verified-over-TLS fetch - and it is the override, not the pinned URL, that an
  # environment can set without editing a committed file.
  assert_secure_url "$distributionUrl" "the distribution URL produced by MVNW_REPOURL"
  verbose "resolved distributionUrl: $(redact_url "$distributionUrl")"
fi
distributionUrlName="${distributionUrl##*/}"
distributionUrlNameMain="${distributionUrlName%.*}"
distributionUrlNameMain="${distributionUrlNameMain%-bin}"
MAVEN_USER_HOME="${MAVEN_USER_HOME:-${HOME}/.m2}"
MAVEN_HOME="${MAVEN_USER_HOME}/wrapper/dists/${distributionUrlNameMain-}/$(hash_string "$distributionUrl")"

# CardDemo addition :: deviation 6. The three facts that make a cache trustworthy,
# and the two that make installing one safe under concurrency.
#
# _MVNW_URL_MARKER is the file this launcher writes into a distribution directory
# immediately before publishing it. Its presence is what distinguishes a directory
# this launcher finished installing from one that some other process left behind
# part way through, and its content is what proves the directory holds the
# distribution the hash in its path claims - the hash is a 32-bit Java string hash
# of the URL, so it is a cache key and not a collision-free identity.
_MVNW_URL_MARKER=mvnw.url
_MVNW_LOCK_DIR="$MAVEN_HOME.lock"
_MVNW_LOCK_OWNED=false

# A cache counts as installed only when the launcher it will be executed from is
# actually there, the library directory it needs is actually there, and the marker
# names this exact distribution. Upstream trusts the existence of the directory
# alone, so a partial install - an interrupted extraction, a copy that ran out of
# space, a cross-filesystem move that failed half way - is executed rather than
# repaired, and executed by every later invocation as well.
maven_home_is_valid() {
  [ -d "$MAVEN_HOME" ] || return 1
  [ -f "$MAVEN_HOME/bin/$MVN_CMD" ] || return 1
  [ -d "$MAVEN_HOME/lib" ] || return 1
  [ -f "$MAVEN_HOME/$_MVNW_URL_MARKER" ] || return 1
  [ "$(trim "$(cat "$MAVEN_HOME/$_MVNW_URL_MARKER" 2>/dev/null)")" = "$distributionUrl" ] || return 1
}

release_lock() {
  [ "$_MVNW_LOCK_OWNED" = true ] || return 0
  _MVNW_LOCK_OWNED=false
  rm -rf -- "$_MVNW_LOCK_DIR" 2>/dev/null || :
}

clean() {
  [ -z "${TMP_DOWNLOAD_DIR-}" ] || rm -rf -- "$TMP_DOWNLOAD_DIR" 2>/dev/null || :
  release_lock
}

# A lock is only useful if it cannot outlive its owner. The owner records its pid
# inside the lock directory; a waiter reclaims the lock only once that pid is
# provably gone, and only after five seconds, so the window between creating the
# directory and writing the pid file can never be mistaken for an abandoned lock.
reclaim_stale_lock() {
  [ "$_mvnw_waited" -ge 5 ] || return 0
  [ -f "$_MVNW_LOCK_DIR/pid" ] || return 0
  _mvnw_lock_pid="$(cat "$_MVNW_LOCK_DIR/pid" 2>/dev/null)" || return 0
  case "$_mvnw_lock_pid" in
  '' | *[!0-9]*) return 0 ;;
  esac
  ! kill -0 "$_mvnw_lock_pid" 2>/dev/null || return 0
  verbose "reclaiming the install lock at $_MVNW_LOCK_DIR left behind by process $_mvnw_lock_pid"
  rm -rf -- "$_MVNW_LOCK_DIR" 2>/dev/null || :
}

# mkdir is the portable atomic test-and-set: exactly one of several concurrent
# invocations creates the directory and the rest fail, with no helper utility and
# no filesystem-specific locking primitive involved. Returns 0 when this process
# holds the lock and 1 when the wait ended because another invocation published a
# valid cache, which is a success for the caller rather than a failure.
acquire_lock() {
  _mvnw_waited=0
  _mvnw_lock_timeout="${MVNW_LOCK_TIMEOUT_SECONDS:-300}"
  until mkdir -- "$_MVNW_LOCK_DIR" 2>/dev/null; do
    if maven_home_is_valid; then
      verbose "another invocation finished installing $MAVEN_HOME while this one waited"
      return 1
    fi
    if [ "$_mvnw_waited" -ge "$_mvnw_lock_timeout" ]; then
      die "waited ${_mvnw_lock_timeout}s for the Maven distribution install lock at $_MVNW_LOCK_DIR and it is still held. If no other build is running, remove that directory and retry; set MVNW_LOCK_TIMEOUT_SECONDS to wait longer."
    fi
    reclaim_stale_lock
    sleep 1
    _mvnw_waited=$((_mvnw_waited + 1))
  done
  _MVNW_LOCK_OWNED=true
  printf %s\\n "$$" >"$_MVNW_LOCK_DIR/pid" 2>/dev/null || :
  return 0
}

# A staging directory is named after the cache entry it is being built for, so any
# left behind by an invocation that was killed outright - SIGKILL runs no trap -
# belongs to this distribution alone and can be removed here, under the lock,
# rather than accumulating in the user's Maven home indefinitely. Globbing is
# disabled for the script as a whole, so it is enabled for exactly this loop and
# the literal-pattern case is handled by the existence test.
discard_stale_staging_dirs() {
  set +f
  for _mvnw_stale in "$MAVEN_HOME".install.*; do
    if [ -e "$_mvnw_stale" ]; then
      verbose "removing a staging directory left behind at $_mvnw_stale"
      rm -rf -- "$_mvnw_stale" 2>/dev/null || :
    fi
  done
  set -f
}

# Held under the lock, so nothing is installing into the directory being discarded.
# Renaming before deleting means a reader that opened the old path keeps reading a
# consistent tree, and the rebuild below cannot race the delete.
quarantine_invalid_maven_home() {
  [ -e "$MAVEN_HOME" ] || return 0
  _mvnw_quarantine="$MAVEN_HOME.invalid.$$"
  printf %s\\n "Discarding an incomplete Maven distribution at $MAVEN_HOME and installing it again." >&2
  rm -rf -- "$_mvnw_quarantine" 2>/dev/null || :
  mv -- "$MAVEN_HOME" "$_mvnw_quarantine" || die "cannot set aside the incomplete Maven distribution at $MAVEN_HOME"
  rm -rf -- "$_mvnw_quarantine" 2>/dev/null || :
}

exec_maven() {
  # The lock and the staging directory are released here rather than in the EXIT
  # trap, because exec replaces this process and no trap of ours will run again.
  clean
  unset MVNW_VERBOSE MVNW_USERNAME MVNW_PASSWORD MVNW_REPOURL || :
  exec "$MAVEN_HOME/bin/$MVN_CMD" "$@" || die "cannot exec $MAVEN_HOME/bin/$MVN_CMD"
}

if maven_home_is_valid; then
  verbose "found a complete MAVEN_HOME at $MAVEN_HOME"
  exec_maven "$@"
fi

# The cache parent has to exist before either the lock directory or the staging
# directory can be created inside it, and both are created inside it deliberately:
# the lock is per distribution, and staging beside the destination is what makes
# publication a rename on one filesystem rather than a copy across two.
mkdir -p -- "${MAVEN_HOME%/*}" || die "cannot create the wrapper cache directory ${MAVEN_HOME%/*}"

# Installed before the lock is taken, so an interrupt during the wait still
# releases it.
trap clean HUP INT TERM EXIT

if acquire_lock; then
  # Re-checked under the lock: between the fast path above and the lock being
  # granted, another invocation may have installed the distribution in full.
  if maven_home_is_valid; then
    verbose "found a complete MAVEN_HOME at $MAVEN_HOME"
    exec_maven "$@"
  fi
  quarantine_invalid_maven_home
  discard_stale_staging_dirs
else
  exec_maven "$@"
fi

# prepare tmp dir
# CardDemo modification :: deviation 6. Staged beside the destination inside the
# cache parent instead of in the system temporary directory, and named after the
# cache entry it is being built for. Upstream stages in /tmp and installs with a
# move, which on the common layout where /tmp is a separate mount is not a rename
# but a recursive copy - interruptible half way, and published under the final name
# while still incomplete.
if TMP_DOWNLOAD_DIR="$(mktemp -d "$MAVEN_HOME.install.XXXXXX")" && [ -d "$TMP_DOWNLOAD_DIR" ]; then
  :
else
  die "cannot create a staging directory beside $MAVEN_HOME"
fi

# Download and Install Apache Maven
verbose "Couldn't find MAVEN_HOME, downloading and installing it ..."
verbose "Downloading from: $(redact_url "$distributionUrl")"
verbose "Downloading to: $TMP_DOWNLOAD_DIR/$distributionUrlName"

# CardDemo modification. The archive is ALWAYS the .zip named in
# .mvn/wrapper/maven-wrapper.properties, and the URL is never rewritten here.
# Upstream switches to the .tar.gz variant when unzip is absent, but
# distributionSha256Sum digests the .zip, so that path could only ever fail - and
# only on the machines that have no unzip, which is where the wrapper has to work
# hardest. Absent unzip is handled where it is actually a problem, at extraction,
# by the JDK-only fallback further down.

# verbose opt
__MVNW_QUIET_WGET=--quiet __MVNW_QUIET_CURL=--silent __MVNW_QUIET_UNZIP=-q
[ "${MVNW_VERBOSE-}" != true ] || __MVNW_QUIET_WGET='' __MVNW_QUIET_CURL='' __MVNW_QUIET_UNZIP=''

# normalize http auth
case "${MVNW_PASSWORD:+has-password}" in
'') MVNW_USERNAME='' MVNW_PASSWORD='' ;;
has-password) [ -n "${MVNW_USERNAME-}" ] || MVNW_USERNAME='' MVNW_PASSWORD='' ;;
esac

# CardDemo modification :: deviation 5. Each downloader is told, in its own terms,
# that a redirect may not leave https and may not loop. The digest below would
# catch substituted CONTENT either way; what a digest cannot catch is the request
# itself being replayed in clear text, or an authenticated retry offering its
# credentials to whichever host a redirect chain ends at. wget's flags are probed
# rather than assumed, because they are GNU extensions and the BusyBox wget found
# on minimal images rejects an unknown option outright - the fetch has to keep
# working there, and the URL is already required to be https.
__MVNW_WGET_TRANSPORT=''
if [ -z "${MVNW_USERNAME-}" ] && command -v wget >/dev/null; then
  if wget --help 2>&1 | grep -q -- '--https-only'; then
    __MVNW_WGET_TRANSPORT=true
  else
    verbose "this wget has no --https-only; the https-only distributionUrl and the mandatory digest still hold"
  fi
fi

if [ -z "${MVNW_USERNAME-}" ] && command -v wget >/dev/null; then
  verbose "Found wget ... using wget"
  if [ "$__MVNW_WGET_TRANSPORT" = true ]; then
    wget ${__MVNW_QUIET_WGET:+"$__MVNW_QUIET_WGET"} --https-only --max-redirect=5 "$distributionUrl" -O "$TMP_DOWNLOAD_DIR/$distributionUrlName" || die "wget: Failed to fetch $(redact_url "$distributionUrl")"
  else
    wget ${__MVNW_QUIET_WGET:+"$__MVNW_QUIET_WGET"} "$distributionUrl" -O "$TMP_DOWNLOAD_DIR/$distributionUrlName" || die "wget: Failed to fetch $(redact_url "$distributionUrl")"
  fi
elif [ -z "${MVNW_USERNAME-}" ] && command -v curl >/dev/null; then
  verbose "Found curl ... using curl"
  curl ${__MVNW_QUIET_CURL:+"$__MVNW_QUIET_CURL"} --proto '=https' --proto-redir '=https' --max-redirs 5 -f -L -o "$TMP_DOWNLOAD_DIR/$distributionUrlName" "$distributionUrl" || die "curl: Failed to fetch $(redact_url "$distributionUrl")"
elif set_java_home; then
  verbose "Falling back to use Java to download"
  javaSource="$TMP_DOWNLOAD_DIR/Downloader.java"
  targetZip="$TMP_DOWNLOAD_DIR/$distributionUrlName"
  # CardDemo modification :: deviation 5. This is the branch that carries
  # credentials - the wget and curl branches above run only when MVNW_USERNAME is
  # empty - so it is the branch where a redirect matters most. Upstream opens the
  # URL as a stream and lets HttpURLConnection follow redirects with a global
  # Authenticator installed, which answers a challenge from whatever host the chain
  # reaches. Here the redirects are followed one hop at a time, every hop has to be
  # https and free of embedded userinfo, the chain is bounded, and the credentials
  # are offered only to the host the properties file named.
  cat >"$javaSource" <<'END_WRAPPER_DOWNLOADER'
public class Downloader extends java.net.Authenticator {
  private static final int MAX_HOPS = 5;
  private static String allowedHost;

  @Override
  protected java.net.PasswordAuthentication getPasswordAuthentication() {
    if (allowedHost == null || !allowedHost.equalsIgnoreCase(getRequestingHost())) {
      return null;
    }
    String user = System.getenv("MVNW_USERNAME");
    String password = System.getenv("MVNW_PASSWORD");
    if (user == null || user.isEmpty() || password == null) {
      return null;
    }
    return new java.net.PasswordAuthentication(user, password.toCharArray());
  }

  private static void requireSecure(java.net.URI uri) throws java.io.IOException {
    if (!"https".equalsIgnoreCase(uri.getScheme())) {
      throw new java.io.IOException("Refusing a distribution URL whose scheme is not https: " + uri.getScheme());
    }
    if (uri.getRawUserInfo() != null) {
      throw new java.io.IOException("Refusing a distribution URL that embeds credentials");
    }
  }

  public static void main(String[] args) throws Exception {
    java.net.URI uri = java.net.URI.create(args[0]);
    requireSecure(uri);
    allowedHost = uri.getHost();
    setDefault(new Downloader());
    java.nio.file.Path target = java.nio.file.Paths.get(args[1]).toAbsolutePath().normalize();
    for (int hop = 0; hop <= MAX_HOPS; hop++) {
      requireSecure(uri);
      java.net.HttpURLConnection connection = (java.net.HttpURLConnection) uri.toURL().openConnection();
      connection.setInstanceFollowRedirects(false);
      connection.setConnectTimeout(30000);
      connection.setReadTimeout(600000);
      int status = connection.getResponseCode();
      if (status == java.net.HttpURLConnection.HTTP_MOVED_PERM
          || status == java.net.HttpURLConnection.HTTP_MOVED_TEMP
          || status == java.net.HttpURLConnection.HTTP_SEE_OTHER
          || status == 307
          || status == 308) {
        String location = connection.getHeaderField("Location");
        connection.disconnect();
        if (location == null || location.isEmpty()) {
          throw new java.io.IOException("Redirect carried no Location header");
        }
        uri = uri.resolve(location);
        continue;
      }
      if (status != java.net.HttpURLConnection.HTTP_OK) {
        connection.disconnect();
        throw new java.io.IOException("Unexpected HTTP status " + status + " fetching the Maven distribution");
      }
      try (java.io.InputStream input = connection.getInputStream()) {
        java.nio.file.Files.copy(input, target, java.nio.file.StandardCopyOption.REPLACE_EXISTING);
      }
      return;
    }
    throw new java.io.IOException("Refusing to follow more than " + MAX_HOPS + " redirects");
  }
}
END_WRAPPER_DOWNLOADER
  # For Cygwin/MinGW, switch paths to Windows format before running javac and java
  verbose " - Compiling Downloader.java ..."
  "$(native_path "$JAVACCMD")" "$(native_path "$javaSource")" || die "Failed to compile Downloader.java"
  verbose " - Running Downloader.java ..."
  "$(native_path "$JAVACMD")" -cp "$(native_path "$TMP_DOWNLOAD_DIR")" Downloader "$distributionUrl" "$(native_path "$targetZip")" || die "Failed to fetch $(redact_url "$distributionUrl") with the JDK"
fi

# Validate the SHA-256 sum of the Maven distribution zip file.
# CardDemo modification :: deviation 4. Unconditional, because distributionSha256Sum
# was required to be present and well formed before anything was fetched. Upstream
# wraps this whole block in a test for the property being non-empty, which is the
# switch that turns verification off; there is no such switch here. The mvnd branch
# upstream carries at the head of this block is gone with it - mvnd is refused at
# configuration time, so a branch here could never run.
distributionSha256Result=false
if command -v sha256sum >/dev/null; then
  if echo "$distributionSha256Sum  $TMP_DOWNLOAD_DIR/$distributionUrlName" | sha256sum -c - >/dev/null 2>&1; then
    distributionSha256Result=true
  fi
elif command -v shasum >/dev/null; then
  if echo "$distributionSha256Sum  $TMP_DOWNLOAD_DIR/$distributionUrlName" | shasum -a 256 -c >/dev/null 2>&1; then
    distributionSha256Result=true
  fi
elif set_java_home; then
  # CardDemo addition: digest the archive with the JDK when no digest utility is on
  # PATH. Neither sha256sum nor shasum is specified by POSIX, and upstream's response
  # to their absence is to exit 1, which turns a missing convenience utility into a
  # build that cannot run. java.security computes the same digest and keeps
  # verification mandatory: the digest is still compared, and a mismatch still fails
  # closed below.
  verbose " - No digest utility found; digesting with the JDK ..."
  javaDigestSource="$TMP_DOWNLOAD_DIR/WrapperSha256.java"
  cat >"$javaDigestSource" <<'END_WRAPPER_SHA256'
public class WrapperSha256 {
  public static void main(String[] args) throws Exception {
    java.security.MessageDigest digest = java.security.MessageDigest.getInstance("SHA-256");
    byte[] buffer = new byte[65536];
    try (java.io.InputStream input =
        java.nio.file.Files.newInputStream(java.nio.file.Paths.get(args[0]))) {
      for (int read = input.read(buffer); read != -1; read = input.read(buffer)) {
        digest.update(buffer, 0, read);
      }
    }
    StringBuilder hex = new StringBuilder(64);
    for (byte value : digest.digest()) {
      hex.append(Character.forDigit((value >> 4) & 0xF, 16));
      hex.append(Character.forDigit(value & 0xF, 16));
    }
    System.out.println(hex);
  }
}
END_WRAPPER_SHA256
  "$(native_path "$JAVACCMD")" "$(native_path "$javaDigestSource")" || die "Failed to compile WrapperSha256.java"
  computedSha256Sum="$("$(native_path "$JAVACMD")" -cp "$(native_path "$TMP_DOWNLOAD_DIR")" WrapperSha256 "$(native_path "$TMP_DOWNLOAD_DIR/$distributionUrlName")")" || die "Failed to compute the distribution SHA-256 with the JDK"
  # The configured value is lowercase hex by contract and the digest above is
  # emitted lowercase, so a plain string comparison is exact; trim only removes
  # the line terminator the JVM printed.
  if [ "$(trim "$computedSha256Sum")" = "$distributionSha256Sum" ]; then
    distributionSha256Result=true
  fi
else
  echo "The Maven distribution has to be verified and no 'sha256sum' or 'shasum' is available and no JDK could be located." >&2
  echo "Set JAVA_HOME to a JDK, or put java and javac on PATH, so the digest can be computed without either command." >&2
  exit 1
fi
if [ $distributionSha256Result = false ]; then
  echo "Error: Failed to validate Maven distribution SHA-256, your Maven distribution might be compromised." >&2
  echo "If you updated your Maven version, you need to update the specified distributionSha256Sum property." >&2
  exit 1
fi

# unzip and move
if command -v unzip >/dev/null; then
  unzip ${__MVNW_QUIET_UNZIP:+"$__MVNW_QUIET_UNZIP"} "$TMP_DOWNLOAD_DIR/$distributionUrlName" -d "$TMP_DOWNLOAD_DIR" || die "failed to unzip"
elif set_java_home; then
  # CardDemo addition: extract the pinned .zip with the JDK when unzip is absent. This
  # replaces the upstream 'tar xzf' branch, which could only ever run against the
  # .tar.gz variant the launcher no longer fetches; the JDK's zip filesystem provider
  # reads exactly the archive whose digest was verified above, so no second, unpinned
  # checksum is needed to install Maven without unzip.
  #
  # The provider is opened with enablePosixFileAttributes so each extracted file
  # receives the permission bits recorded in the archive - which is what makes bin/mvn
  # executable and leaves bin/mvn.cmd alone - rather than guessing from path names.
  # Directories take the platform default, so a directory's own bits can never be
  # applied before its contents are written. Where there is no POSIX view at all, under
  # Cygwin or MinGW, the launchers under bin/ are marked executable directly.
  # Extraction outside the target directory is refused twice: the provider rejects an
  # archive whose entry names contain '..', and the check below is a second barrier.
  verbose " - No unzip found; extracting with the JDK ..."
  javaUnzipSource="$TMP_DOWNLOAD_DIR/WrapperUnzipper.java"
  cat >"$javaUnzipSource" <<'END_WRAPPER_UNZIPPER'
public class WrapperUnzipper {
  public static void main(String[] args) throws Exception {
    java.nio.file.Path archive = java.nio.file.Paths.get(args[0]).toAbsolutePath().normalize();
    java.nio.file.Path target = java.nio.file.Paths.get(args[1]).toAbsolutePath().normalize();
    boolean posix = java.nio.file.FileSystems.getDefault().supportedFileAttributeViews().contains("posix");
    java.util.Map<String, Object> options = new java.util.HashMap<>();
    options.put("enablePosixFileAttributes", Boolean.TRUE);
    try (java.nio.file.FileSystem zip = java.nio.file.FileSystems.newFileSystem(archive, options)) {
      for (java.nio.file.Path root : zip.getRootDirectories()) {
        try (java.util.stream.Stream<java.nio.file.Path> entries = java.nio.file.Files.walk(root)) {
          java.util.Iterator<java.nio.file.Path> iterator = entries.iterator();
          while (iterator.hasNext()) {
            java.nio.file.Path entry = iterator.next();
            String name = root.relativize(entry).toString();
            if (name.isEmpty()) {
              continue;
            }
            java.nio.file.Path resolved = target.resolve(name).normalize();
            if (!resolved.startsWith(target)) {
              throw new java.io.IOException("Refusing to extract outside the target directory: " + name);
            }
            if (java.nio.file.Files.isDirectory(entry)) {
              java.nio.file.Files.createDirectories(resolved);
              continue;
            }
            java.nio.file.Files.createDirectories(resolved.getParent());
            java.nio.file.Files.copy(entry, resolved, java.nio.file.StandardCopyOption.REPLACE_EXISTING);
            if (posix) {
              java.nio.file.Files.setPosixFilePermissions(resolved, java.nio.file.Files.getPosixFilePermissions(entry));
            } else if (name.contains("bin/")) {
              resolved.toFile().setExecutable(true, false);
            }
          }
        }
      }
    }
  }
}
END_WRAPPER_UNZIPPER
  "$(native_path "$JAVACCMD")" "$(native_path "$javaUnzipSource")" || die "Failed to compile WrapperUnzipper.java"
  "$(native_path "$JAVACMD")" -cp "$(native_path "$TMP_DOWNLOAD_DIR")" WrapperUnzipper "$(native_path "$TMP_DOWNLOAD_DIR/$distributionUrlName")" "$(native_path "$TMP_DOWNLOAD_DIR")" || die "failed to extract the distribution with the JDK"
else
  die "Cannot extract $distributionUrlName: no 'unzip' is available and no JDK could be located. Set JAVA_HOME to a JDK, or put java and javac on PATH."
fi

# Find the actual extracted directory name (handles snapshots where filename != directory name)
actualDistributionDir=""

# First try the expected directory name (for regular distributions)
if [ -d "$TMP_DOWNLOAD_DIR/$distributionUrlNameMain" ]; then
  if [ -f "$TMP_DOWNLOAD_DIR/$distributionUrlNameMain/bin/$MVN_CMD" ]; then
    actualDistributionDir="$distributionUrlNameMain"
  fi
fi

# If not found, search for any directory with the Maven executable (for snapshots)
if [ -z "$actualDistributionDir" ]; then
  # enable globbing to iterate over items
  set +f
  for dir in "$TMP_DOWNLOAD_DIR"/*; do
    if [ -d "$dir" ]; then
      if [ -f "$dir/bin/$MVN_CMD" ]; then
        actualDistributionDir="$(basename "$dir")"
        break
      fi
    fi
  done
  set -f
fi

if [ -z "$actualDistributionDir" ]; then
  verbose "Contents of $TMP_DOWNLOAD_DIR:"
  verbose "$(ls -la "$TMP_DOWNLOAD_DIR")"
  die "Could not find Maven distribution directory in extracted archive"
fi

verbose "Found extracted Maven distribution directory: $actualDistributionDir"

# CardDemo modification :: deviation 6. Publication, in the one order that makes a
# partially installed cache unobservable.
#
# The marker is written while the tree is still staged and still under a name no
# other invocation looks for, so the directory becomes complete before it becomes
# visible. The rename is then a single atomic operation on one filesystem, because
# staging happened inside the cache parent - a reader either sees no MAVEN_HOME or
# sees the finished one, never a half-copied one.
#
# The failure is a failure. Upstream writes `|| [ -d "$MAVEN_HOME" ] ||`, which
# accepts a failed move whenever something already occupies the destination - the
# very situation a failed move creates when the destination is a partial tree from
# an earlier interrupted install. Here the rename is required to succeed, and the
# published result is then validated by the same predicate the fast path uses, so
# no invocation can execute a distribution this one did not finish installing.
printf %s\\n "$distributionUrl" >"$TMP_DOWNLOAD_DIR/$actualDistributionDir/$_MVNW_URL_MARKER"
mv -- "$TMP_DOWNLOAD_DIR/$actualDistributionDir" "$MAVEN_HOME" || die "cannot publish the Maven distribution to $MAVEN_HOME"
maven_home_is_valid || die "the Maven distribution published to $MAVEN_HOME is not complete; refusing to run a build on it"

exec_maven "$@"
