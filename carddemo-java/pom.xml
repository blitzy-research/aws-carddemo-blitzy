  CardDemo - AWS Mainframe Modernization
  Java 25 LTS / Spring Boot 3.5.x target module for the COBOL CardDemo estate.

  Provenance of the migrated behaviour (never transcribed, only cited):
    source checkout SHA : 7756d895ffeb65f7ea72aaa609e356d9899afcec
    upstream stamp      : CardDemo_v1.0-15-g27d6c6f-68 (2022-07-19)

  Build contract:
    * <release>25</release> with -Xlint:all -Werror  -> zero-warning build is enforced by javac.
    * JaCoCo enforces a FAILING check at 80% line coverage.
    * OWASP dependency-check is wired to the `verify` phase; it is skipped by default so a
      developer build never depends on the NVD feed, and is executed in CI / on demand with
      -Ddependency-check.skip=false (see README and .github/workflows/carddemo-java-ci.yml).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.carddemo</groupId>
  <artifactId>carddemo-java</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <name>carddemo-java</name>
  <description>AWS CardDemo mainframe estate migrated to Java 25 LTS and Spring Boot 3.5.x</description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <!-- Toolchain -->
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Versions NOT managed by the Spring Boot 3.5.16 BOM -->
    <spring-cloud-aws.version>3.4.2</spring-cloud-aws.version>
    <logstash-logback-encoder.version>9.0</logstash-logback-encoder.version>
    <springdoc-openapi.version>2.8.17</springdoc-openapi.version>
    <jjwt.version>0.12.7</jjwt.version>
    <jacoco-maven-plugin.version>0.8.15</jacoco-maven-plugin.version>
    <dependency-check-maven.version>12.1.3</dependency-check-maven.version>

    <!--
      ====================================================================================
      SECURITY REMEDIATION OVERRIDES  -  DO NOT REVERT WITHOUT RE-RUNNING THE CVE SCAN
      ====================================================================================
      These five coordinates override the transitive versions that Spring Boot 3.5.16 (and
      the OpenTelemetry / logstash-encoder trees) would otherwise select. Each override is
      the minimum version that clears a CVE with a CVSS score >= 7.0, as reported by an
      ACTUALLY EXECUTED `org.owasp:dependency-check-maven:12.1.3:check` run against a fully
      populated NVD cache (372,190 records).

      Why this deviates from the AAP dependency table (spec section 0.5.1):
        * Section 0.5.1 pins `tomcat-embed-core 10.1.55` and `postgresql 42.7.11`. Those were the
          BOM-managed versions at AAP-analysis time and PREDATE the advisories below.
        * Section 0.9.8 (Gate 8) requires "zero critical or high CVEs".
        Those two requirements now conflict, so the security requirement wins and the
        override is documented here and in the setup guide. Spring Boot itself stays on the
        AAP-pinned 3.5.16 parent - verified as still the newest release on the 3.x line, so no
        parent bump is available or permitted (4.1.0 would breach the "3.x" contract ceiling).

      All five are property overrides / BOM pins only. No direct dependency declaration and
      no plugin version changes; every bump stays inside the same minor line except the two
      unmanaged transitives (semconv, Jackson 3) which move by one minor.

        tomcat.version      10.1.55 -> 10.1.57  clears CVE-2026-53434(9.1) CVE-2026-55276(9.1)
                                                CVE-2026-59083(9.1) CVE-2026-59084(9.1)
                                                CVE-2026-53404(7.3). 10.1.56 is INSUFFICIENT:
                                                59083/59084 are "affected <= 10.1.56".
        netty.version    4.1.135 -> 4.1.136.Final  clears CVE-2026-56820(9.1) CVE-2026-55851(8.7)
                                                CVE-2026-56745(8.7) CVE-2026-56817(8.3)
                                                CVE-2026-44891/55831/55833/56819 (7.5 each).
                                                Applied via the Boot BOM's netty-bom import, so
                                                every netty module moves together.
        postgresql.version 42.7.11 -> 42.7.13  clears CVE-2026-54291(8.2) (affected 42.7.4-42.7.11).
        opentelemetry-semconv 1.32.0 -> 1.43.0 clears CVE-2026-39883(7.3) (needs >= 1.43.0) and
                                                CVE-2026-24051(7.0) (needs >= 1.40.0). Not managed
                                                by the Boot BOM, so pinned in dependencyManagement.
        tools.jackson (Jackson 3) 3.0.1 -> 3.2.1  clears CVE-2026-29062(8.7) (needs >= 3.1.0) and
                                                CVE-2026-54512/54513(8.1) (need >= 3.1.4). Reaches
                                                the classpath ONLY via logstash-logback-encoder 9.0.
                                                This is the tools.jackson.core Jackson 3 tree and is
                                                SEPARATE from com.fasterxml.jackson 2.21.4, which the
                                                Boot BOM manages and which is NOT changed.

      KNOWN-UNFIXABLE, deliberately NOT overridden (documented in the setup guide):
        * org.jetbrains.kotlin:kotlin-stdlib 1.9.25 - CVE-2026-53914(9.8), "affected < 2.4.20".
          Version 2.4.20 exists on Maven Central ONLY as 2.4.20-Beta2; the newest STABLE release is
          2.4.10, which is still in range. No stable fix exists, and shipping a Beta stdlib is not
          acceptable. kotlin-stdlib is on the classpath solely because okhttp 4.12.0 (latest 4.x)
          backs the OTLP *HTTP* sender. Recommended remediation for the implementation agents:
          switch to the OTLP *gRPC* sender, which drops okhttp and Kotlin from the tree entirely.
        * org.apache.httpcomponents.core5:httpcore5 5.0.2 - CVE-2026-54399/54428 (7.5 each),
          "affected 5.0 - 5.4.2" (no fixed release published). SHADED inside
          com.github.docker-java:docker-java-transport-zerodep 3.4.2, which arrives through
          Testcontainers 1.21.4, so it is TEST scope only, never shipped, and cannot be replaced
          by dependency management because the classes are relocated inside the jar.
      ====================================================================================
    -->
    <tomcat.version>10.1.57</tomcat.version>
    <netty.version>4.1.136.Final</netty.version>
    <postgresql.version>42.7.13</postgresql.version>
    <opentelemetry-semconv.version>1.43.0</opentelemetry-semconv.version>
    <jackson3.version>3.2.1</jackson3.version>

    <!-- Quality gates -->
    <jacoco.line.coverage.minimum>0.80</jacoco.line.coverage.minimum>
    <!--
      OWASP dependency-check is skipped by default: the NVD feed download is slow and rate
      limited without an NVD_API_KEY, and a developer build must not depend on it.
      CI (and any on-demand security run) sets -Ddependency-check.skip=false.
    -->
    <dependency-check.skip>true</dependency-check.skip>

    <!-- Deterministic test JVM: fixed locale/timezone/encoding protects byte-parity fixtures.
         Kept on a SINGLE line on purpose - a wrapped value embeds a newline and leading
         whitespace into the surefire/failsafe <argLine>, which is fragile. -->
    <test.jvm.args>-XX:+EnableDynamicAgentLoading -Xshare:off -Duser.language=en -Duser.country=US -Duser.timezone=UTC -Dfile.encoding=UTF-8</test.jvm.args>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        SECURITY PINS FIRST. For import-scope BOMs the first declaration wins, so these must
        precede the spring-cloud-aws import. See the SECURITY REMEDIATION OVERRIDES comment in
        <properties> for the CVE evidence behind each version.
      -->

      <!-- Jackson 3 (tools.jackson.*) arrives only via logstash-logback-encoder 9.0 and is NOT
           managed by the Spring Boot BOM. Distinct from com.fasterxml.jackson 2.21.4. -->
      <dependency>
        <groupId>tools.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson3.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- OpenTelemetry semantic-convention constants ride their own release train, separate
           from ${opentelemetry.version}, and are not managed by the Spring Boot BOM. -->
      <dependency>
        <groupId>io.opentelemetry.semconv</groupId>
        <artifactId>opentelemetry-semconv</artifactId>
        <version>${opentelemetry-semconv.version}</version>
      </dependency>

      <dependency>
        <groupId>io.awspring.cloud</groupId>
        <artifactId>spring-cloud-aws-dependencies</artifactId>
        <version>${spring-cloud-aws.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- ============================ Spring Boot starters ============================ -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-batch</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- ============================ Persistence / schema ============================ -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- ================================ AWS (awspring) ============================== -->
    <dependency>
      <groupId>io.awspring.cloud</groupId>
      <artifactId>spring-cloud-aws-starter-s3</artifactId>
    </dependency>
    <dependency>
      <groupId>io.awspring.cloud</groupId>
      <artifactId>spring-cloud-aws-starter-sqs</artifactId>
    </dependency>
    <dependency>
      <groupId>io.awspring.cloud</groupId>
      <artifactId>spring-cloud-aws-starter-sns</artifactId>
    </dependency>

    <!-- =============================== Observability ================================ -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>
    <dependency>
      <groupId>net.logstash.logback</groupId>
      <artifactId>logstash-logback-encoder</artifactId>
      <version>${logstash-logback-encoder.version}</version>
    </dependency>

    <!-- ============================== API documentation ============================= -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc-openapi.version}</version>
    </dependency>

    <!-- ============================== Token / JWT support ===========================
         The AAP mandates config/JwtTokenProvider.java + config/JwtProperties.java (stateless
         JWT claims replacing CARDDEMO-COMMAREA carriage) but §0.5.1 lists no JWT provider.
         Both mainstream implementations are supplied so the token layer compiles either way:
           * io.jsonwebtoken (jjwt)          - explicit pin, no annotation processor
           * spring-security-oauth2-jose     - Spring-native Nimbus JOSE encoder/decoder
         Remove whichever one the implementation does not use.                            -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-oauth2-jose</artifactId>
    </dependency>

    <!-- ==================================== Test ==================================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.batch</groupId>
      <artifactId>spring-batch-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>localstack</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>${project.artifactId}-${project.version}</finalName>
    <plugins>
      <!-- Zero-warning compilation: Gate 2 is enforced by javac, not by review. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${maven.compiler.release}</release>
          <parameters>true</parameters>
          <showDeprecation>true</showDeprecation>
          <showWarnings>true</showWarnings>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
      </plugin>

      <!-- Unit tests: *Test.java, excluding integration (*IT) and end-to-end suites. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} ${test.jvm.args}</argLine>
          <includes>
            <include>**/*Test.java</include>
          </includes>
          <excludes>
            <exclude>**/*IT.java</exclude>
            <exclude>**/*E2ETest.java</exclude>
            <exclude>**/e2e/**/*.java</exclude>
          </excludes>
        </configuration>
      </plugin>

      <!-- Integration + end-to-end tests: container backed, run in the verify lifecycle.

           No <executions> block is declared here on purpose. spring-boot-starter-parent
           already contributes a failsafe execution with id "default" bound to
           integration-test + verify, and that inherited execution also sets
           classesDirectory to ${project.build.outputDirectory} so the tests run
           against target/classes rather than against the repackaged executable jar.
           Adding a second execution would duplicate both goals in every build and
           risk running the whole integration suite twice, so the configuration below
           is attached at plugin level and merges into the inherited execution. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} ${test.jvm.args}</argLine>
          <includes>
            <include>**/*IT.java</include>
            <include>**/*E2ETest.java</include>
            <include>**/e2e/**/*Test.java</include>
          </includes>
        </configuration>
      </plugin>

      <!-- Coverage: report + FAILING check at 80% line coverage (Gate 7). -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <executions>
          <execution>
            <id>jacoco-prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-prepare-agent-integration</id>
            <goals>
              <goal>prepare-agent-integration</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-report-integration</id>
            <phase>verify</phase>
            <goals>
              <goal>report-integration</goal>
            </goals>
          </execution>
          <execution>
            <id>jacoco-check-line-coverage</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>${jacoco.line.coverage.minimum}</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Supply-chain scan (Gate 8). Skipped by default; CI runs it with -Ddependency-check.skip=false. -->
      <plugin>
        <groupId>org.owasp</groupId>
        <artifactId>dependency-check-maven</artifactId>
        <version>${dependency-check-maven.version}</version>
        <configuration>
          <skip>${dependency-check.skip}</skip>
          <failBuildOnCVSS>7.0</failBuildOnCVSS>
          <formats>
            <format>HTML</format>
            <format>JSON</format>
          </formats>
          <!-- Supply an NVD API key on the command line when running the scan:
               ./mvnw -B verify -Ddependency-check.skip=false -DnvdApiKey=$NVD_API_KEY -->
          <nvdValidForHours>24</nvdValidForHours>
          <skipTestScope>false</skipTestScope>
        </configuration>
        <executions>
          <execution>
            <id>owasp-dependency-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Executable artifact packaging.

           mainClass is declared explicitly rather than discovered by classpath
           scanning so that the entry point named in the specification
           (com.carddemo.CardDemoApplication) is the build contract. Until that
           class exists, the repackage goal fails with "Unable to find main
           class", which is the expected state of a module whose application
           sources have not yet been generated. -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.carddemo.CardDemoApplication</mainClass>
          <layers>
            <enabled>true</enabled>
          </layers>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
