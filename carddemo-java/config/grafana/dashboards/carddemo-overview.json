{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "CardDemo Java module overview: REST endpoint latency/throughput, Spring Batch step timings, JVM and datasource health. Source of the Gate 3 performance baseline.",
  "editable": false,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "REST endpoints (BMS screen contract)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate by URI",
      "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
          "editorMode": "code",
          "expr": "sum by (uri, method) (rate(http_server_requests_seconds_count{job=\"carddemo-java\"}[1m]))",
          "legendFormat": "{{method}} {{uri}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP latency p95 by URI",
      "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 0 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"carddemo-java\"}[5m])))",
          "legendFormat": "{{uri}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP error rate (4xx / 5xx)",
      "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
          "editorMode": "code",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"carddemo-java\", status=~\"4..|5..\"}[1m]))",
          "legendFormat": "HTTP {{status}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Application uptime",
      "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
          "editorMode": "code",
          "expr": "process_uptime_seconds{job=\"carddemo-java\"}",
          "legendFormat": "uptime",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Spring Batch (JCL job replacement)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Batch step duration (p95)",
      "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, name) (rate(spring_batch_step_seconds_bucket{job=\"carddemo-java\"}[5m])))",
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Batch item throughput (records/s)",
      "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
          "editorMode": "code",
          "expr": "sum by (name) (rate(spring_batch_item_process_seconds_count{job=\"carddemo-java\"}[1m]))",
          "legendFormat": "{{name}}",
          "range": true,
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "JVM and datasource",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "JVM heap used vs committed",
      "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
          "editorMode": "code",
          "expr": "sum(jvm_memory_used_bytes{job=\"carddemo-java\", area=\"heap\"})",
          "legendFormat": "heap used",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
          "editorMode": "code",
          "expr": "sum(jvm_memory_committed_bytes{job=\"carddemo-java\", area=\"heap\"})",
          "legendFormat": "heap committed",
          "range": true,
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HikariCP connections",
      "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
          "editorMode": "code",
          "expr": "hikaricp_connections_active{job=\"carddemo-java\"}",
          "legendFormat": "active",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "carddemo-prometheus" },
          "editorMode": "code",
          "expr": "hikaricp_connections_idle{job=\"carddemo-java\"}",
          "legendFormat": "idle",
          "range": true,
          "refId": "B"
        }
      ]
    }
  ],
  "preload": false,
  "refresh": "10s",
