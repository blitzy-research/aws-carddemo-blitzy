# Developer profile overrides. None of these can match a committed profile document: the
# secret form requires the literal segment "secret" and the local form requires a
# ".local.yml" suffix that application-local.yml does not have.
application-secret*.yml
application-secret*.yaml
**/application-secret*.yml
**/application-secret*.yaml
application-*.local.yml
application-*.local.yaml
**/application-*.local.yml
**/application-*.local.yaml
application-local.properties
**/application-local.properties

# Local-stack definitions and the container recipes themselves. The image is built from
# the module source; the compose stack that brings up PostgreSQL, the emulated AWS
# services and the observability backends is a developer tool, not an image input, and
# config/ and localstack/ are mounted by that stack rather than copied into the image.
docker-compose.yml
docker-compose.yaml
docker-compose.*.yml
docker-compose.*.yaml
compose.yml
compose.yaml
Dockerfile*
.dockerignore
config/
localstack/

# Local stack state, if a named volume is ever switched to a bind mount.
postgres-data/
**/postgres-data/
localstack-data/
**/localstack-data/
prometheus-data/
**/prometheus-data/
grafana-data/
**/grafana-data/
volume/
volumes/
**/volume/
**/volumes/
.localstack/
**/.localstack/

# The Windows launcher: the builder stage is Linux and runs ./mvnw only.

# Documentation, version-control metadata and CI definitions: none affects the artefact,
